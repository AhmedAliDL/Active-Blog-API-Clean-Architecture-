{
  "AllowedHosts": "*",
  "JWT": {
    "SecurityKey": "",
    "Issuer": "https://localhost:7030",
    "Audience": "http://localhost:4200",
    "ExpirationInMinutes": 30,
    "ExpirationOfRefreshTokenInDays": 10

  },
  "SmtpSettings": {
    "SmtpServer": "",
    "Port": 587,
    "SmtpEmail": "",
    "Password": "",
    "AdminEmail": ""
  },

  "CompanyInfo": {
    "email": "",
    "password": ""
  },
  "ConnectionStrings": {
    "constr": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
